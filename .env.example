# Stripe (required). Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Admin sign-in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Flask session signing. Any long random string.
SECRET_KEY=change-me

# Order emails with the photographs attached (optional). Without these the
# order page still offers every download.
RESEND_API_KEY=
FROM_EMAIL=AyoZon <orders@yourdomain.com>

# Database (optional). Leave blank, or point at an unreachable cluster, and the
# API stores everything in data/store.json instead.
MONGO_URI=

# Fill an empty shop with the demo photographs in seed/ (set to 0 to start empty)
SEED_DEMO=1

# Only needed when the frontend is hosted on a different origin than the API
FRONTEND_ORIGIN=http://localhost:5173
